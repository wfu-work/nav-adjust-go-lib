<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>{{.Title}}</title>
  <style>
    :root {
      --ink: #111a1f;
      --ink-soft: #2b3940;
      --muted: #66757d;
      --line: #d7dee1;
      --line-strong: #b9c4c9;
      --surface: #ffffff;
      --canvas: #eef2f3;
      --green: #087c62;
      --green-strong: #05664f;
      --green-soft: #e8f4f0;
      --red: #b43d32;
      --red-soft: #fbeceb;
      --blue: #245a73;
      --blue-soft: #edf4f7;
      --amber: #8a5b00;
      --amber-soft: #fff4d5;
      --radius: 8px;
      --radius-small: 6px;
      --shadow: 0 10px 28px rgba(31, 46, 54, .07);
      --shadow-soft: 0 4px 14px rgba(31, 46, 54, .05);
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      background: var(--canvas);
      color: var(--ink);
      font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
      font-size: 14px;
      line-height: 1.6;
      letter-spacing: 0;
    }

    button, input, select { font: inherit; letter-spacing: 0; }

    .report-header {
      position: relative;
      overflow: hidden;
      background: #111a1f;
      color: #fff;
      box-shadow: inset 0 -3px {{if .Passed}}var(--green){{else}}var(--red){{end}};
    }

    .header-inner,
    .report-main,
    .report-footer {
      width: min(1180px, calc(100% - 48px));
      margin: 0 auto;
    }

    .header-inner {
      position: relative;
      z-index: 1;
      min-height: 222px;
      padding: 40px 0 43px;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 230px;
      gap: 64px;
      align-items: center;
    }

    .product {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 0 0 22px;
      color: #aebbc1;
      font-size: 11px;
      font-weight: 750;
    }

    .product::before {
      width: 8px;
      height: 8px;
      content: "";
      background: {{if .Passed}}#42c6a0{{else}}#ff8175{{end}};
      border-radius: 50%;
      box-shadow: 0 0 0 4px rgba(66,198,160,.12);
    }

    h1 {
      margin: 0;
      font-size: 38px;
      line-height: 1.14;
      font-weight: 780;
    }

    .header-copy {
      max-width: 720px;
      margin: 16px 0 0;
      color: #c2ccd0;
      font-size: 15px;
    }

    .suite-status {
      min-width: 0;
      padding: 19px 22px;
      background: rgba(255,255,255,.045);
      border: 1px solid rgba(255,255,255,.12);
      border-radius: var(--radius);
      text-align: left;
    }

    .suite-status::before {
      display: block;
      margin-bottom: 13px;
      color: {{if .Passed}}#58d6b0{{else}}#ff9187{{end}};
      content: "{{if .Passed}}VALIDATION PASSED{{else}}VALIDATION FAILED{{end}}";
      font-size: 10px;
      font-weight: 800;
    }

    .suite-status strong {
      display: block;
      color: #fff;
      font-size: 36px;
      line-height: 1.08;
      font-variant-numeric: tabular-nums;
    }

    .suite-status span {
      display: block;
      margin-top: 7px;
      color: #aebbc1;
      font-size: 12px;
    }

    .report-main { padding: 26px 0 64px; }

    .summary-band {
      display: grid;
      grid-template-columns: .85fr .85fr .85fr 1fr 1.45fr;
      gap: 12px;
    }

    .summary-item {
      position: relative;
      min-width: 0;
      min-height: 102px;
      padding: 20px 22px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow-soft);
      transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease;
    }

    .summary-item:first-child::before {
      position: absolute;
      top: 20px;
      right: 20px;
      width: 9px;
      height: 9px;
      content: "";
      background: {{if .Passed}}var(--green){{else}}var(--red){{end}};
      border-radius: 50%;
      box-shadow: 0 0 0 5px {{if .Passed}}var(--green-soft){{else}}var(--red-soft){{end}};
    }

    .summary-item:first-child {
      background: {{if .Passed}}#f5fbf8{{else}}#fff8f7{{end}};
      border-color: {{if .Passed}}#b9ded3{{else}}#efc7c2{{end}};
    }

    .summary-item:hover {
      border-color: var(--line-strong);
      box-shadow: var(--shadow);
      transform: translateY(-2px);
    }

    .summary-label {
      display: block;
      margin-bottom: 7px;
      color: var(--muted);
      font-size: 11px;
      font-weight: 700;
    }

    .summary-value {
      display: block;
      overflow-wrap: anywhere;
      font-size: 26px;
      font-weight: 760;
      line-height: 1.15;
      font-variant-numeric: tabular-nums;
    }

    .summary-value.small {
      color: var(--ink-soft);
      font-size: 14px;
      line-height: 1.5;
    }

    .overview {
      display: grid;
      grid-template-columns: minmax(0, 1.55fr) minmax(280px, .7fr);
      gap: 34px;
      margin-top: 26px;
      padding: 27px 30px 30px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow-soft);
    }

    .section-title {
      display: flex;
      align-items: center;
      gap: 9px;
      margin: 0 0 18px;
      color: var(--ink-soft);
      font-size: 15px;
      line-height: 1.3;
    }

    .section-title::before {
      width: 3px;
      height: 15px;
      content: "";
      background: var(--green);
      border-radius: 999px;
    }

    .category-row {
      display: grid;
      grid-template-columns: minmax(116px, 168px) minmax(100px, 1fr) 62px;
      gap: 14px;
      align-items: center;
      margin-top: 13px;
    }

    .category-name { color: var(--ink-soft); font-size: 13px; font-weight: 680; }

    .category-track {
      height: 6px;
      overflow: hidden;
      background: #e7ecee;
      border-radius: 999px;
    }

    .category-fill { height: 100%; background: var(--green); border-radius: inherit; }

    .category-count {
      color: var(--muted);
      text-align: right;
      font-size: 12px;
      font-variant-numeric: tabular-nums;
    }

    .run-meta {
      padding-left: 32px;
      border-left: 1px solid var(--line);
    }

    .meta-row {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      padding: 9px 0;
      border-bottom: 1px solid #e9edef;
      font-size: 12px;
    }

    .meta-row:last-child { border-bottom: 0; }
    .meta-row span:first-child { color: var(--muted); }
    .meta-row span:last-child { color: var(--ink-soft); text-align: right; font-weight: 650; }

    .scenario-toolbar {
      position: sticky;
      top: 0;
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      margin: 34px 0 18px;
      padding: 12px 0;
      background: rgba(238,242,243,.94);
      backdrop-filter: blur(12px);
    }

    .toolbar-title { margin: 0; font-size: 21px; line-height: 1.25; }

    .filter-group {
      display: inline-flex;
      gap: 2px;
      padding: 4px;
      background: #dde5e7;
      border: 1px solid #ccd6da;
      border-radius: var(--radius);
      box-shadow: inset 0 1px 2px rgba(31,46,54,.05);
    }

    .filter-button {
      min-width: 76px;
      min-height: 34px;
      padding: 6px 14px;
      color: #405059;
      background: transparent;
      border: 0;
      border-radius: var(--radius-small);
      cursor: pointer;
      font-size: 12px;
      font-weight: 680;
    }

    .filter-button:hover { background: rgba(255,255,255,.7); }
    .filter-button[aria-pressed="true"] { color: #fff; background: var(--ink-soft); box-shadow: 0 2px 7px rgba(17,26,31,.18); }
    .filter-button:focus-visible { outline: 3px solid #75abc1; outline-offset: 1px; }

    .visible-count { color: var(--muted); font-size: 12px; white-space: nowrap; }

    .scenario-list { display: grid; gap: 22px; }

    .scenario {
      position: relative;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow-soft);
      overflow: hidden;
      transition: border-color .18s ease, box-shadow .18s ease;
    }

    .scenario::before {
      position: absolute;
      top: 20px;
      bottom: auto;
      left: 0;
      width: 4px;
      height: 48px;
      content: "";
      background: var(--green);
      border-radius: 0 4px 4px 0;
    }

    .scenario:hover { border-color: #c4cfd3; box-shadow: var(--shadow); }
    .scenario.failed::before { background: var(--red); }
    .scenario[hidden] { display: none; }

    .scenario-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 26px;
      padding: 24px 26px 20px;
      border-bottom: 1px solid var(--line);
    }

    .scenario-kicker {
      margin: 0 0 7px;
      color: var(--blue);
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 11px;
      font-weight: 720;
    }

    .scenario h3 {
      margin: 0;
      font-size: 21px;
      line-height: 1.3;
    }

    .scenario-description {
      max-width: 820px;
      margin: 8px 0 0;
      color: var(--muted);
      font-size: 13px;
    }

    .status-badge {
      position: relative;
      align-self: start;
      min-width: 70px;
      padding: 7px 11px 7px 27px;
      color: var(--green-strong);
      background: var(--green-soft);
      border: 1px solid #b8ddd1;
      border-radius: 999px;
      text-align: center;
      font-size: 12px;
      font-weight: 760;
    }

    .status-badge::before {
      position: absolute;
      top: 50%;
      left: 11px;
      width: 7px;
      height: 7px;
      content: "";
      background: var(--green);
      border-radius: 50%;
      transform: translateY(-50%);
    }

    .failed .status-badge { color: var(--red); background: var(--red-soft); border-color: #ecc4bf; }
    .failed .status-badge::before { background: var(--red); }

    .scenario-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 26px;
      padding: 11px 26px;
      color: var(--muted);
      background: #f8fafb;
      border-bottom: 1px solid var(--line);
      font-size: 11px;
    }

    .scenario-meta strong {
      margin-right: 5px;
      color: #35444c;
      font-weight: 720;
    }

    .error-box,
    .warning-box {
      margin: 18px 26px 0;
      padding: 12px 14px;
      border-left: 3px solid;
      border-radius: var(--radius-small);
    }

    .error-box { color: #7f2f26; background: var(--red-soft); border-color: var(--red); }
    .warning-box { color: #704d00; background: var(--amber-soft); border-color: #c48a18; }

    .metrics {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      padding: 0 26px;
      background: #fbfcfc;
      border-bottom: 1px solid var(--line);
    }

    .metric {
      min-width: 0;
      margin: 16px 0;
      padding: 2px 14px 2px 0;
      border-right: 1px solid var(--line);
    }

    .metric + .metric { padding-left: 14px; }
    .metric:last-child { border-right: 0; }
    .metric-label { display: block; margin-bottom: 3px; color: var(--muted); font-size: 10px; font-weight: 650; }
    .metric-value { display: block; overflow-wrap: anywhere; color: var(--ink-soft); font-size: 17px; font-weight: 740; font-variant-numeric: tabular-nums; }
    .metric-unit { color: var(--muted); font-size: 10px; font-weight: 550; }

    .scenario-section { padding: 20px 26px 23px; }
    .scenario-section + .scenario-section { border-top: 1px solid var(--line); }

    .scenario-section h4 {
      margin: 0 0 13px;
      color: var(--ink-soft);
      font-size: 13px;
    }

    .table-wrap {
      width: 100%;
      overflow-x: auto;
      border: 1px solid #dfe5e7;
      border-radius: var(--radius-small);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 11px;
      font-variant-numeric: tabular-nums;
    }

    th, td {
      padding: 10px 11px;
      border-bottom: 1px solid #e5eaec;
      text-align: left;
      vertical-align: middle;
      white-space: nowrap;
    }

    th {
      color: #526169;
      background: #eef3f4;
      font-size: 10px;
      font-weight: 760;
    }

    tbody tr:nth-child(even) td { background: #fafcfc; }
    tbody tr:hover td { background: var(--blue-soft); }
    tbody tr:last-child td { border-bottom: 0; }
    .number { text-align: right; }

    .check-mark {
      display: inline-grid;
      width: 19px;
      height: 19px;
      place-items: center;
      color: #fff;
      background: var(--green);
      border-radius: 50%;
      font-size: 11px;
      font-weight: 800;
    }

    .check-mark.failed { background: var(--red); }

    details { border-top: 1px solid var(--line); }

    summary {
      position: relative;
      padding: 14px 50px 14px 26px;
      color: var(--blue);
      cursor: pointer;
      font-size: 12px;
      font-weight: 720;
      list-style: none;
    }

    summary::-webkit-details-marker { display: none; }
    summary::after {
      position: absolute;
      top: 50%;
      right: 28px;
      width: 7px;
      height: 7px;
      content: "";
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      transform: translateY(-65%) rotate(45deg);
      transition: transform .18s ease;
    }

    summary:hover { background: #f7fafb; }
    details[open] summary { background: #f7fafb; border-bottom: 1px solid var(--line); }
    details[open] summary::after { transform: translateY(-30%) rotate(225deg); }

    .empty-state {
      display: none;
      padding: 48px 24px;
      color: var(--muted);
      background: var(--surface);
      border: 1px dashed var(--line-strong);
      border-radius: var(--radius);
      text-align: center;
    }

    .empty-state.visible { display: block; }

    .report-footer {
      padding: 27px 0 38px;
      color: var(--muted);
      border-top: 1px solid var(--line);
      font-size: 11px;
    }

    code {
      color: var(--blue);
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    }

    @media (max-width: 900px) {
      .header-inner { grid-template-columns: minmax(0, 1fr) 190px; gap: 40px; }
      .summary-band { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .summary-item:last-child { grid-column: 1 / -1; }
      .overview { grid-template-columns: 1fr; }
      .run-meta { padding: 22px 0 0; border: 0; border-top: 1px solid var(--line); }
      .metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .metric:nth-child(3n) { border-right: 0; }
    }

    @media (max-width: 640px) {
      .header-inner, .report-main, .report-footer { width: min(100% - 24px, 1180px); }
      .header-inner { min-height: 0; grid-template-columns: 1fr; gap: 24px; padding: 29px 0 31px; }
      .product { margin-bottom: 17px; font-size: 9px; }
      h1 { font-size: 29px; }
      .header-copy { margin-top: 12px; font-size: 13px; }
      .suite-status { display: grid; grid-template-columns: auto 1fr; align-items: end; column-gap: 12px; padding: 15px 17px; }
      .suite-status::before { grid-column: 1 / -1; margin-bottom: 0; }
      .suite-status strong { font-size: 29px; }
      .suite-status span { margin: 0 0 2px; }
      .summary-band { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .summary-item { min-height: 86px; padding: 16px; }
      .summary-item:first-child::before { top: 17px; right: 17px; }
      .summary-item:last-child { grid-column: 1 / -1; }
      .summary-label { margin-bottom: 4px; font-size: 10px; }
      .summary-value { font-size: 22px; }
      .overview { gap: 22px; margin-top: 18px; padding: 21px 18px 23px; }
      .category-row { grid-template-columns: 96px minmax(60px, 1fr) 50px; gap: 9px; }
      .category-name { font-size: 11px; }
      .scenario-toolbar { position: static; align-items: flex-start; flex-direction: column; margin-top: 26px; padding-top: 0; background: transparent; backdrop-filter: none; }
      .filter-group { width: 100%; }
      .filter-button { flex: 1; min-width: 0; }
      .scenario-list { gap: 16px; }
      .scenario-head { grid-template-columns: minmax(0, 1fr) auto; gap: 12px; padding: 20px 18px 17px; }
      .scenario h3 { font-size: 18px; }
      .status-badge { min-width: 0; padding: 6px 9px 6px 23px; }
      .status-badge::before { left: 9px; width: 6px; height: 6px; }
      .scenario-description { grid-column: 1 / -1; font-size: 12px; }
      .scenario-meta { display: grid; grid-template-columns: 1fr 1fr; gap: 7px 14px; padding: 12px 18px; }
      .scenario-meta span:first-child { grid-column: 1 / -1; }
      .error-box, .warning-box { margin-right: 18px; margin-left: 18px; }
      .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); padding: 0 18px; }
      .metric { margin: 13px 0; }
      .metric:nth-child(3n) { border-right: 1px solid var(--line); }
      .metric:nth-child(2n) { border-right: 0; }
      .scenario-section { padding: 17px 18px 20px; }
      .metric-value { font-size: 15px; }
      summary { padding-right: 42px; padding-left: 18px; }
      summary::after { right: 20px; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .summary-item, .scenario { transition: none; }
      summary::after { transition: none; }
    }

    @media print {
      body { background: #fff; }
      .summary-band, .scenario { box-shadow: none; }
      .summary-item { box-shadow: none; }
      .scenario-toolbar { display: none; }
      .scenario { break-inside: avoid; }
      details > * { display: block !important; }
    }
  </style>
</head>
<body>
  <header class="report-header">
    <div class="header-inner">
      <div>
        <p class="product">NAV-ADJUST-GO-LIB / DETERMINISTIC VALIDATION</p>
        <h1>{{.Title}}</h1>
        <p class="header-copy">基于确定性合成真值验证固定基准、随机模型、自由网、稳健估计、方差分量、稀疏求解和非线性迭代。</p>
      </div>
      <div class="suite-status" aria-label="总体状态">
        <strong>{{status .Passed}}</strong>
        <span>{{.PassCount}} / {{.Total}} 场景满足全部断言</span>
      </div>
    </div>
  </header>

  <main class="report-main">
    <section class="summary-band" aria-label="验证摘要">
      <div class="summary-item"><span class="summary-label">通过率</span><span class="summary-value">{{passPercent .PassCount .Total}}%</span></div>
      <div class="summary-item"><span class="summary-label">通过场景</span><span class="summary-value">{{.PassCount}}</span></div>
      <div class="summary-item"><span class="summary-label">失败场景</span><span class="summary-value">{{.FailCount}}</span></div>
      <div class="summary-item"><span class="summary-label">总运行时间</span><span class="summary-value">{{duration .Duration}}</span></div>
      <div class="summary-item"><span class="summary-label">生成时间</span><span class="summary-value small">{{timefmt .GeneratedAt}}</span></div>
    </section>

    <section class="overview" aria-labelledby="overview-title">
      <div>
        <h2 class="section-title" id="overview-title">分类覆盖</h2>
        {{range .Categories}}
        <div class="category-row">
          <span class="category-name">{{.Name}}</span>
          <div class="category-track" aria-label="{{.Name}} 通过率"><div class="category-fill" style="width: {{passPercent .Passed .Total}}%"></div></div>
          <span class="category-count">{{.Passed}} / {{.Total}}</span>
        </div>
        {{end}}
      </div>
      <div class="run-meta">
        <h2 class="section-title">运行环境</h2>
        <div class="meta-row"><span>Go</span><span>{{.GoVersion}}</span></div>
        <div class="meta-row"><span>场景数</span><span>{{.Total}}</span></div>
        <div class="meta-row"><span>结果判定</span><span>真值误差 + 诊断断言</span></div>
        <div class="meta-row"><span>数据源</span><span>mock 确定性合成</span></div>
      </div>
    </section>

    <section aria-labelledby="scenarios-title">
      <div class="scenario-toolbar">
        <div>
          <h2 class="toolbar-title" id="scenarios-title">场景明细</h2>
          <span class="visible-count" id="visible-count">显示 {{.Total}} 个场景</span>
        </div>
        <div class="filter-group" role="group" aria-label="结果筛选">
          <button class="filter-button" type="button" data-filter="all" aria-pressed="true">全部</button>
          <button class="filter-button" type="button" data-filter="passed" aria-pressed="false">通过</button>
          <button class="filter-button" type="button" data-filter="failed" aria-pressed="false">失败</button>
        </div>
      </div>

      <div class="scenario-list" id="scenario-list">
        {{range .Scenarios}}
        <article class="scenario {{if not .Passed}}failed{{end}}" data-status="{{if .Passed}}passed{{else}}failed{{end}}" id="scenario-{{.ID}}">
          <div class="scenario-head">
            <div>
              <p class="scenario-kicker">{{.Category}} / {{.ID}}</p>
              <h3>{{.Name}}</h3>
              <p class="scenario-description">{{.Description}}</p>
            </div>
            <span class="status-badge">{{status .Passed}}</span>
          </div>
          <div class="scenario-meta">
            <span><strong>输入</strong> {{.Input}}</span>
            <span><strong>求解器</strong> {{if .Solver}}{{.Solver}}{{else}}n/a{{end}}</span>
            <span><strong>耗时</strong> {{duration .Duration}}</span>
          </div>
          {{if .Error}}<div class="error-box"><strong>运行错误：</strong>{{.Error}}</div>{{end}}
          {{if .Warnings}}<div class="warning-box"><strong>求解警告：</strong>{{range $i, $warning := .Warnings}}{{if $i}}；{{end}}{{$warning}}{{end}}</div>{{end}}
          {{if .Metrics}}
          <div class="metrics">
            {{range .Metrics}}
            <div class="metric"><span class="metric-label">{{.Label}}</span><span class="metric-value">{{.Value}} {{if .Unit}}<span class="metric-unit">{{.Unit}}</span>{{end}}</span></div>
            {{end}}
          </div>
          {{end}}
          {{if .Checks}}
          <section class="scenario-section">
            <h4>验证断言</h4>
            <div class="table-wrap">
              <table>
                <thead><tr><th>状态</th><th>检查项</th><th>期望</th><th>实际</th></tr></thead>
                <tbody>
                  {{range .Checks}}
                  <tr><td><span class="check-mark {{if not .Passed}}failed{{end}}">{{if .Passed}}✓{{else}}×{{end}}</span></td><td>{{.Name}}</td><td>{{.Expected}}</td><td>{{.Actual}}</td></tr>
                  {{end}}
                </tbody>
              </table>
            </div>
          </section>
          {{end}}
          {{if .Stations}}
          <details>
            <summary>真值坐标对照（{{len .Stations}} 行）</summary>
            <section class="scenario-section">
              <div class="table-wrap">
                <table>
                  <thead><tr><th>站点</th><th class="number">真值 E</th><th class="number">真值 N</th><th class="number">真值 U</th><th class="number">平差 E</th><th class="number">平差 N</th><th class="number">平差 U</th><th class="number">三维误差 / m</th></tr></thead>
                  <tbody>
                    {{range .Stations}}
                    <tr><td>{{.ID}}</td><td class="number">{{printf "%.5f" .Truth.East}}</td><td class="number">{{printf "%.5f" .Truth.North}}</td><td class="number">{{printf "%.5f" .Truth.Up}}</td><td class="number">{{printf "%.5f" .Adjusted.East}}</td><td class="number">{{printf "%.5f" .Adjusted.North}}</td><td class="number">{{printf "%.5f" .Adjusted.Up}}</td><td class="number">{{printf "%.6f" .Error}}</td></tr>
                    {{end}}
                  </tbody>
                </table>
              </div>
            </section>
          </details>
          {{end}}
          {{if .Residuals}}
          <details>
            <summary>最大基线残差（{{len .Residuals}} 行）</summary>
            <section class="scenario-section">
              <div class="table-wrap">
                <table>
                  <thead><tr><th>基线</th><th>分组</th><th class="number">残差模 / m</th><th class="number">最终权</th></tr></thead>
                  <tbody>
                    {{range .Residuals}}
                    <tr><td>{{.ID}}</td><td>{{if .Group}}{{.Group}}{{else}}default{{end}}</td><td class="number">{{printf "%.6f" .Norm}}</td><td class="number">{{printf "%.6f" .Weight}}</td></tr>
                    {{end}}
                  </tbody>
                </table>
              </div>
            </section>
          </details>
          {{end}}
        </article>
        {{end}}
      </div>
      <div class="empty-state" id="empty-state">当前筛选条件下没有场景。</div>
    </section>
  </main>

  <footer class="report-footer">
    报告由 <code>go run ./cmd/mock-report</code> 生成。所有坐标误差均相对 mock 包内确定性真值计算。
  </footer>

  <script>
    (() => {
      const buttons = Array.from(document.querySelectorAll('[data-filter]'));
      const scenarios = Array.from(document.querySelectorAll('.scenario'));
      const count = document.getElementById('visible-count');
      const empty = document.getElementById('empty-state');
      const applyFilter = (filter) => {
        let visible = 0;
        scenarios.forEach((scenario) => {
          const show = filter === 'all' || scenario.dataset.status === filter;
          scenario.hidden = !show;
          if (show) visible += 1;
        });
        buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filter === filter)));
        count.textContent = `显示 ${visible} 个场景`;
        empty.classList.toggle('visible', visible === 0);
      };
      buttons.forEach((button) => button.addEventListener('click', () => applyFilter(button.dataset.filter)));
    })();
  </script>
</body>
</html>
